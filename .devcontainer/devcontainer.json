{
  "name": "Laboratorio Zero Trust · NicaHackfest",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "root",
  "runArgs": [
    "--cap-add=NET_RAW",
    "--cap-add=NET_ADMIN"
  ],
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "rmdir /lab 2>/dev/null; ln -sfn \"${containerWorkspaceFolder}\" /lab && chmod +x /lab/lab /lab/pki/*.sh /lab/soluciones/*.sh",
  "postAttachCommand": "lab bienvenida",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.cwd": "/lab",
        "workbench.startupEditor": "readme",
        "workbench.editorAssociations": {
          "*.md": "vscode.markdown.preview.editor"
        }
      }
    },
    "codespaces": {
      "openFiles": [
        "guia/00-inicio.md"
      ]
    }
  }
}
